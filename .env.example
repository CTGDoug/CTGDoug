# Copy to .env and fill in. Never commit the real .env file.
# The CLI reads these from the process environment; if you use a process
# manager (systemd, cron + env file, etc.) load this file there instead of
# relying on python-dotenv.

# Hudu instance and API key (Admin > API in your Hudu instance)
HUDU_BASE_URL=https://yourcompany.huducloud.com
HUDU_API_KEY=

# Path to a Keeper Secrets Manager client config JSON, created via:
#   keeper secrets-manager client add-client --app <app-name> --config-init json
# The KSM Application must have EDIT access to every shared folder listed in
# scope_map.json below, not just read access, or create/update calls will fail.
KEEPER_CONFIG_PATH=./keeper_config.json

# Path to the Hudu company <-> Keeper folder mapping, see scope_map.example.json
SCOPE_MAP_PATH=./scope_map.json

# Optional
STATE_DB_PATH=hudu_keeper_sync_state.db
CONFLICT_WINNER=hudu
REQUEST_TIMEOUT_SECONDS=30
